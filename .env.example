# FilmBuddy Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM generation)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Override default LLM model (default: gpt-4o)
# FILMBUDDY_LLM_MODEL=gpt-4o-mini

# Optional: Corpus configuration
# FILMBUDDY_CORPUS=corpus/la_la_land_chunks.jsonl
# FILMBUDDY_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FILMBUDDY_TOPK=6
# FILMBUDDY_MAXCANDS=128

# Temporal boosting (prioritize recent content)
# FILMBUDDY_TEMPORAL_WEIGHT=0.3  # Weight for temporal proximity (0-1, higher = more recency bias)
# FILMBUDDY_TEMPORAL_DECAY=300   # Decay window in seconds (default: 5 minutes)
