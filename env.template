# FilmBuddy Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# TMDB API Configuration
# =============================================================================
# Get your API key from: https://www.themoviedb.org/settings/api
# Required for: Fetching movie metadata, cast information, and character details
TMDB_API_KEY=your_tmdb_api_key_here

# =============================================================================
# Azure OpenAI Configuration (for LLM API calls)
# =============================================================================
# Azure OpenAI API Key - Required for character extraction and scene summaries
# Get this from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Azure OpenAI Endpoint - Your Azure OpenAI resource endpoint
# Copy the "Target URI" from your deployment page in Azure portal
AZURE_OPENAI_ENDPOINT=https://jrhee-mgpqli8a-eastus2.cognitiveservices.azure.com/

# Azure OpenAI API Version - The API version to use
# See: https://learn.microsoft.com/en-us/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure OpenAI Deployment Name - The name of your model deployment
# This is the deployment name you created in Azure (shown under "Deployment info" → "Name")
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# =============================================================================
# Notes
# =============================================================================
# - Keep this file secure and never commit .env to version control
# - The .gitignore should already include .env
# - All services will fall back to these environment variables
# - Azure OpenAI configuration is shared between preprocessing and runtime server

